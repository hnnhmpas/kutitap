rules_version = '2';
// Only the owner can read or write the tracker. Everything else is closed.
// Replace PASTE_OWNER_UID with your Firebase Authentication User UID (Console > Authentication > Users).
service cloud.firestore {
  match /databases/{database}/documents {
    match /financeTracker/user_data {
      allow read, write: if request.auth != null && request.auth.uid == 'PASTE_OWNER_UID';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
